# Required: shared team access code (give this to teammates, not the public)
ACCESS_CODE=change-me-to-a-long-secret

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Required: only these people can sign in. Format: Full Name <work@email.com>; Full Name <work@email.com>
# Leave empty to refuse everyone. The access code is not enough on its own.
TEAM_ALLOWLIST=

# Optional legacy alias (emails only). Prefer TEAM_ALLOWLIST.
# TEAM_EMAIL_ALLOWLIST=you@firm.com,teammate@firm.com

# --- AI provider (set at least one) ---
# Vercel AI Gateway (recommended on Vercel)
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5

# Or call a provider directly
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Research ---
# Tavily is used for live company/news/peer search. Without it, the agent can only fetch URLs you provide.
TAVILY_API_KEY=

# Optional fallback search
BRAVE_SEARCH_API_KEY=

# --- Persistence on Vercel ---
# Create a Blob store in the Vercel dashboard. Local dev uses the .data folder instead.
BLOB_READ_WRITE_TOKEN=
